{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true
  },
  "include": ["src", "scripts", "tests"],
  "exclude": [
    "node_modules",
    "dist",
    "src/providers/_adapter-template.ts",
    "src/cli/commands/_command-template.ts"
  ]
}
